#!/bin/bash
# =============================================================================
#  tophat — run the TUI when it is usable, otherwise run install.sh
#
#  The TUI is strictly additive. Anything unusual (no runtime, no dependencies,
#  not a terminal, arguments given, --no-tui) falls back to the Bash installer,
#  so this launcher can never be the reason an install cannot run.
#
#  The runtime is *provisioned*, never embedded: a compiled binary would freeze
#  Bun inside it, and a runtime CVE would then wait on our release cadence
#  rather than Bun's. Bun is looked up first and installed only on request.
#
#  Usage:
#    ./tophat                      TUI when possible, else install.sh
#    ./tophat --no-tui [opts...]   always install.sh
#    ./tophat --install-runtime    install Bun into a managed dir, then start
#    ./tophat --diagnose           report what was found and what would happen
#    ./tophat [options...]         arguments are passed to install.sh
# =============================================================================
set -euo pipefail

ROOT="${TOPHAT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
INSTALL="$ROOT/install.sh"
TUI_ENTRY="$ROOT/tui/src/index.tsx"

usage() {
  cat <<'EOF'
Usage: ./tophat [OPTIONS] [install.sh options...]

Runs Tophat behind a terminal UI when that is possible, and the plain installer
otherwise.

Options:
  --no-tui            Always run install.sh
  --install-runtime   Install Bun into a managed directory, then start the TUI
  --diagnose          Report what was found and what would happen
  --help, -h          Show this message

The TUI needs Bun. It is not bundled: a compiled binary would freeze the
runtime, so a Bun security fix would wait for a Tophat release instead of
reaching you through `bun upgrade` (or `dnf upgrade`, if Bun is packaged).
./tophat looks for Bun in this order:

  1. $TOPHAT_BUN
  2. bun in $PATH
  3. the managed directory (see --diagnose)
  4. ~/.bun/bin/bun

Without a terminal, without the TUI dependencies, or with any other argument,
this runs install.sh unchanged. install.sh never needs Bun.

Keep the runtime patched: `bun upgrade` for a managed copy, `dnf upgrade` for a
packaged one. The TUI shows the version it is running on its first screen.
EOF
}

args=()
use_tui=true
install_runtime=false
diagnose=false

for arg in "$@"; do
  case "$arg" in
    --help | -h)
      usage
      exit 0
      ;;
    --no-tui) use_tui=false ;;
    --install-runtime) install_runtime=true ;;
    --diagnose) diagnose=true ;;
    *) args+=("$arg") ;;
  esac
done
((${#args[@]} == 0)) || use_tui=false

is_root() { [[ ${EUID:-$(id -u)} -eq 0 ]]; }

# Where a runtime installed by this launcher lives.
runtime_dir() {
  if [[ -n "${TOPHAT_BUN_DIR:-}" ]]; then
    printf '%s' "$TOPHAT_BUN_DIR"
  elif is_root; then
    printf '%s' "/var/lib/tophat/bun"
  else
    printf '%s/.local/share/tophat/bun' "${HOME:-/root}"
  fi
}

has_deps() { [[ -d "$ROOT/tui/node_modules/@opentui" ]]; }

# An explicit override, then whatever the system provides (a packaged Bun, or
# the official installer's default location), then our own managed copy.
find_bun() {
  local candidate

  if [[ -n "${TOPHAT_BUN:-}" && -x "${TOPHAT_BUN}" ]]; then
    printf '%s' "$TOPHAT_BUN"
    return 0
  fi
  if candidate="$(command -v bun 2>/dev/null)" && [[ -n "$candidate" ]]; then
    printf '%s' "$candidate"
    return 0
  fi
  candidate="$(runtime_dir)/bin/bun"
  if [[ -x "$candidate" ]]; then
    printf '%s' "$candidate"
    return 0
  fi
  candidate="${HOME:-/root}/.bun/bin/bun"
  if [[ -x "$candidate" ]]; then
    printf '%s' "$candidate"
    return 0
  fi
  return 1
}

# tui | needs-runtime | fallback
decide() {
  if [[ "$use_tui" != true ]]; then
    printf 'fallback'
    return
  fi
  if ! [[ -t 0 && -t 1 ]]; then
    printf 'fallback'
    return
  fi
  if ! has_deps; then
    printf 'fallback'
    return
  fi
  if ! find_bun >/dev/null 2>&1; then
    printf 'needs-runtime'
    return
  fi
  printf 'tui'
}

install_runtime() {
  local dir installer
  dir="$(runtime_dir)"
  mkdir -p "$dir"
  printf 'Installing Bun into %s (official installer: https://bun.sh/install)\n' "$dir" >&2
  installer="$(mktemp)"
  curl -fsSL https://bun.sh/install -o "$installer"
  BUN_INSTALL="$dir" bash "$installer" >&2
  rm -f "$installer"
  printf 'Bun installed in %s. Keep it patched with: %s/bin/bun upgrade\n' "$dir" "$dir" >&2
}

explain_fallback() {
  [[ "$use_tui" == true ]] || return 0

  if ! has_deps; then
    printf 'TUI dependencies are missing (cd tui && bun install); using install.sh.\n' >&2
    return 0
  fi
  if ! find_bun >/dev/null 2>&1; then
    printf 'The TUI needs Bun, which is not installed; using install.sh.\n' >&2
    printf 'Install it with ./tophat --install-runtime, or use --no-tui to silence this.\n' >&2
    return 0
  fi
  if ! [[ -t 0 && -t 1 ]]; then
    printf 'No terminal attached; using install.sh (run ./tophat in a terminal for the TUI).\n' >&2
  fi
}

fallback() {
  exec bash "$INSTALL" "$@"
}

if [[ "$diagnose" == true ]]; then
  bun_path="$(find_bun || true)"
  printf 'root=%s\n' "$ROOT"
  printf 'install=%s\n' "$INSTALL"
  printf 'tui_entry=%s\n' "$TUI_ENTRY"
  printf 'deps=%s\n' "$(has_deps && echo yes || echo no)"
  printf 'bun=%s\n' "${bun_path:-none}"
  printf 'runtime_dir=%s\n' "$(runtime_dir)"
  printf 'tty=%s\n' "$([[ -t 0 && -t 1 ]] && echo yes || echo no)"
  printf 'decision=%s\n' "$(decide)"
  printf 'update_hint=%s\n' "$(find_bun >/dev/null 2>&1 && printf 'keep it patched: bun upgrade (managed) or dnf upgrade (packaged)' || printf 'run --install-runtime to provision it')"
  exit 0
fi

case "$(decide)" in
  tui)
    exec "$(find_bun)" "$TUI_ENTRY" "${args[@]}"
    ;;
  needs-runtime)
    if [[ "$install_runtime" == true ]]; then
      install_runtime
    else
      dir="$(runtime_dir)"
      printf 'The TUI needs Bun, which is not installed.\n' >&2
      printf 'Install it into %s now? [y/N] ' "$dir" >&2
      answer=""
      read -r answer || answer=""
      case "$answer" in
        y | Y | yes | YES) install_runtime ;;
        *)
          printf 'Falling back to the Bash installer. Use --no-tui to skip this prompt, or --install-runtime to automate it.\n' >&2
          fallback "${args[@]}"
          ;;
      esac
    fi
    if ! bun_path="$(find_bun)"; then
      printf 'Bun installation finished but no runtime was found; falling back.\n' >&2
      fallback "${args[@]}"
    fi
    exec "$bun_path" "$TUI_ENTRY" "${args[@]}"
    ;;
  *)
    explain_fallback
    fallback "${args[@]}"
    ;;
esac
