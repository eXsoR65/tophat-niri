#!/bin/bash
# =============================================================================
#  tophat — run the TUI when it is usable, otherwise run install.sh
#
#  The TUI is strictly additive. Anything unusual (no runtime, no dependencies,
#  not a terminal, arguments given, --no-tui) falls back to the Bash installer,
#  so this launcher can never be the reason an install cannot run.
#
#  The runtime is *provisioned*, never embedded: a compiled binary would freeze
#  Bun inside it, and a runtime CVE would then wait on our release cadence
#  rather than Bun's. Bun is looked up first and installed only on request.
#
#  Usage:
#    ./tophat                      TUI when possible, else install.sh
#    ./tophat --no-tui [opts...]   always install.sh
#    ./tophat --install-runtime    install Bun (official installer), then start
#    ./tophat --diagnose           report what was found and what would happen
#    ./tophat [options...]         arguments are passed to install.sh
# =============================================================================
set -euo pipefail

# Resolve symlinks: people put ./tophat on PATH, and dirname of a link points at
# the link's directory, not the checkout.
_script="${BASH_SOURCE[0]}"
while [[ -L "$_script" ]]; do
  _dir="$(cd "$(dirname "$_script")" && pwd)"
  _script="$(readlink "$_script")"
  [[ "$_script" == /* ]] || _script="$_dir/$_script"
done
ROOT="${TOPHAT_ROOT:-$(cd "$(dirname "$_script")" && pwd)}"
# The TUI resolves install.sh and packages/ from this, so a symlinked launcher
# and the child agree on where the checkout is.
export TOPHAT_ROOT="$ROOT"
INSTALL="$ROOT/install.sh"
TUI_ENTRY="$ROOT/tui/src/index.tsx"

usage() {
  cat <<'EOF'
Usage: ./tophat [OPTIONS] [install.sh options...]

Runs Tophat behind a terminal UI when that is possible, and the plain installer
otherwise.

Options:
  --no-tui            Always run install.sh
  --install-runtime   Install Bun with its official installer, then start the TUI
  --diagnose          Report what was found and what would happen
  --help, -h          Show this message

The TUI needs Bun. It is not bundled: a compiled binary would freeze the
runtime, so a Bun security fix would wait for a Tophat release instead of
reaching you through `bun upgrade` (or `dnf upgrade`, if Bun is packaged).

Bun is installed the way its documentation says, and found where that
installer leaves it:

  1. $TOPHAT_BUN (escape hatch for tests and unusual setups)
  2. bun in $PATH (a packaged Bun, or an install you have already reloaded)
  3. ~/.bun/bin/bun (the official installer's default location, for the
     current shell before your profile picks it up)

Without a terminal, without the TUI dependencies, or with any other argument,
this runs install.sh unchanged. install.sh never needs Bun.

Keep the runtime patched: `bun upgrade` for the official install, `dnf upgrade`
for a packaged one. The TUI shows the version it is running on its first screen.
EOF
}

args=()
use_tui=true
install_runtime=false
diagnose=false

for arg in "$@"; do
  case "$arg" in
    --help | -h)
      usage
      exit 0
      ;;
    --no-tui) use_tui=false ;;
    --install-runtime) install_runtime=true ;;
    --diagnose) diagnose=true ;;
    *) args+=("$arg") ;;
  esac
done
((${#args[@]} == 0)) || use_tui=false

# Bun's official installer puts the runtime in ~/.bun and adds ~/.bun/bin to
# PATH in your shell profile. So: PATH first (packaged Bun, or an install whose
# profile has been reloaded), then that default directory for the current shell.
BUN_BIN="${HOME:-/root}/.bun/bin/bun"

has_deps() { [[ -d "$ROOT/tui/node_modules/@opentui" ]]; }

find_bun() {
  local candidate

  # An escape hatch for tests and unusual setups, nothing more.
  if [[ -n "${TOPHAT_BUN:-}" && -x "${TOPHAT_BUN}" ]]; then
    printf '%s' "$TOPHAT_BUN"
    return 0
  fi
  if candidate="$(command -v bun 2>/dev/null)" && [[ -n "$candidate" ]]; then
    printf '%s' "$candidate"
    return 0
  fi
  if [[ -x "$BUN_BIN" ]]; then
    printf '%s' "$BUN_BIN"
    return 0
  fi
  return 1
}

# tui | needs-runtime | fallback
decide() {
  if [[ "$use_tui" != true ]]; then
    printf 'fallback'
    return
  fi
  if ! [[ -t 0 && -t 1 ]]; then
    printf 'fallback'
    return
  fi
  if ! has_deps; then
    printf 'fallback'
    return
  fi
  if ! find_bun >/dev/null 2>&1; then
    printf 'needs-runtime'
    return
  fi
  printf 'tui'
}

# Installed with the documented command, verbatim. The script decides where Bun
# lives (~/.bun), what it puts on PATH, and what it verifies; we neither copy its
# logic nor override its choices. `set -o pipefail` makes a failed download fail
# the install rather than running bash on an empty pipe.
install_runtime() {
  printf 'Installing Bun: curl -fsSL https://bun.sh/install | bash\n' >&2
  curl -fsSL https://bun.sh/install | bash
  printf 'Bun installed; keep it patched with: bun upgrade\n' >&2
}

explain_fallback() {
  [[ "$use_tui" == true ]] || return 0

  if ! has_deps; then
    printf 'TUI dependencies are missing (cd tui && bun install); using install.sh.\n' >&2
    return 0
  fi
  if ! find_bun >/dev/null 2>&1; then
    printf 'The TUI needs Bun, which is not installed; using install.sh.\n' >&2
    printf 'Install it with ./tophat --install-runtime, or use --no-tui to silence this.\n' >&2
    return 0
  fi
  if ! [[ -t 0 && -t 1 ]]; then
    printf 'No terminal attached; using install.sh (run ./tophat in a terminal for the TUI).\n' >&2
  fi
}

fallback() {
  exec bash "$INSTALL" "$@"
}

if [[ "$diagnose" == true ]]; then
  bun_path="$(find_bun || true)"
  printf 'root=%s\n' "$ROOT"
  printf 'install=%s\n' "$INSTALL"
  printf 'tui_entry=%s\n' "$TUI_ENTRY"
  printf 'deps=%s\n' "$(has_deps && echo yes || echo no)"
  printf 'bun=%s\n' "${bun_path:-none}"
  printf 'tty=%s\n' "$([[ -t 0 && -t 1 ]] && echo yes || echo no)"
  printf 'decision=%s\n' "$(decide)"
  printf 'update_hint=%s\n' "$(find_bun >/dev/null 2>&1 && printf 'keep it patched: bun upgrade, or dnf upgrade if packaged' || printf 'run --install-runtime to install it the documented way')"
  exit 0
fi

case "$(decide)" in
  tui)
    exec "$(find_bun)" "$TUI_ENTRY" "${args[@]}"
    ;;
  needs-runtime)
    if [[ "$install_runtime" == true ]]; then
      install_runtime
    else
      printf 'The TUI needs Bun, which is not installed.\n' >&2
      printf "Install it now with Bun's official installer? [y/N] " >&2
      answer=""
      read -r answer || answer=""
      case "$answer" in
        y | Y | yes | YES) install_runtime ;;
        *)
          printf 'Falling back to the Bash installer. Use --no-tui to skip this prompt, or --install-runtime to automate it.\n' >&2
          fallback "${args[@]}"
          ;;
      esac
    fi
    if ! bun_path="$(find_bun)"; then
      printf 'Bun installation finished but no runtime was found; falling back.\n' >&2
      fallback "${args[@]}"
    fi
    exec "$bun_path" "$TUI_ENTRY" "${args[@]}"
    ;;
  *)
    explain_fallback
    fallback "${args[@]}"
    ;;
esac
